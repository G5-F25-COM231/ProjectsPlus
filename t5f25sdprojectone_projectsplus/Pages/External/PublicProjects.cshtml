@page
@{
    ViewData["Title"] = "Public Projects";
    ViewData["ShowLoginLink"] = false; // hide top Login link on this page
}

<div class="d-flex flex-column flex-lg-row gap-3">

    <!-- Sidebar / Mentor nav -->
    <aside class="bg-white border rounded-4 p-3 p-lg-4" style="width: 260px; min-width: 220px;">
        <!-- Profile -->
        <div class="d-flex align-items-center mb-4">
            <div class="rounded-circle bg-secondary bg-opacity-25 me-3 d-flex align-items-center justify-content-center"
                 style="width:40px;height:40px;">
                <span class="fw-semibold text-secondary">ER</span>
            </div>
            <div class="small">
                <div class="fw-semibold">Dr. Evelyn Reed</div>
                <div class="text-muted">Mentor</div>
            </div>
        </div>

        <!-- Nav -->
        <nav class="nav nav-pills flex-column gap-1 small">
            <a class="nav-link active d-flex align-items-center" asp-page="/External/PublicProjects">
                <!-- grid icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" width="18" height="18" class="me-2">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M4 4h7v7H4V4zm9 0h7v7h-7V4zM4 13h7v7H4v-7zm9 0h7v7h-7v-7z" />
                </svg>
                Public Projects
            </a>

            <a class="nav-link d-flex align-items-center disabled">
                <!-- folder icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" width="18" height="18" class="me-2">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M3 7h4l2 2h12v10H3V7z" />
                </svg>
                My Projects
            </a>

            <a class="nav-link d-flex align-items-center disabled">
                <!-- star icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" width="18" height="18" class="me-2">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.966a1 1 0 00.95.69h4.174c.969 0 1.371 1.24.588 1.81l-3.38 2.457a1 1 0 00-.364 1.118l1.287 3.966c.3.921-.755 1.688-1.54 1.118l-3.38-2.457a1 1 0 00-1.176 0l-3.38 2.457c-.784.57-1.838-.197-1.539-1.118l1.287-3.966a1 1 0 00-.364-1.118L2.05 9.393c-.783-.57-.38-1.81.588-1.81h4.175a1 1 0 00.95-.69l1.286-3.966z" />
                </svg>
                Featured Students
            </a>

            <a class="nav-link d-flex align-items-center disabled">
                <!-- chat icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" width="18" height="18" class="me-2">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M7 8h10M7 12h6m-8 8l-3-3V5a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2H7z" />
                </svg>
                Chat
            </a>
        </nav>
    </aside>

    <!-- Main content -->
    <section class="flex-grow-1">

        <!-- Top bar -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1 class="h4 fw-semibold mb-1">Public Projects</h1>
                <p class="text-muted small mb-0">
                    Discover projects you can support, follow, or mentor.
                </p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-link text-muted p-0">
                    <!-- bell icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" width="20" height="20">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1" />
                    </svg>
                </button>
                <a asp-page="/Login" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    Logout
                </a>
            </div>
        </div>

        <!-- Search -->
        <div class="bg-white border rounded-4 p-3 p-lg-4 mb-3 shadow-sm">
            <div class="input-group input-group-lg">
                <span class="input-group-text bg-transparent border-end-0">
                    🔍
                </span>
                <input type="search"
                       class="form-control border-start-0"
                       placeholder="Search by skill, tag, or technology" />
            </div>

            <!-- Filter chips -->
            <div class="d-flex flex-wrap gap-2 mt-3 small">
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    Skills
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    Tags
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    Technologies
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    Sort by
                </button>
            </div>
        </div>

        <!-- Loading state (UI only, hidden by default) -->
        <div id="projects-loading" class="text-center py-5 d-none">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted small mb-0">Loading public projects…</p>
        </div>

        <!-- Empty state (UI only, hidden by default) -->
        <div id="projects-empty" class="text-center py-5 d-none">
            <p class="fw-semibold mb-1">No public projects match your filters.</p>
            <p class="text-muted small mb-3">Try adjusting your search or check back later.</p>
            <button class="btn btn-primary btn-sm">Reset filters</button>
        </div>

        <!-- Projects grid -->
        <div id="projects-grid" class="row row-cols-1 row-cols-md-3 g-3">

            <!-- Card 1 -->
            <div class="col">
                <article class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden"
                         style="cursor:pointer;"
                         onclick="window.location='@Url.Page("/External/ProjectDetail", new { id = "ai-powered-tutoring" })'">
                    <div style="height:190px;background:linear-gradient(135deg,#0f172a,#1e293b);"
                         class="d-flex align-items-center justify-content-center">
                        <span class="display-4 text-white fw-semibold">A</span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h2 class="h6 fw-semibold mb-2">AI-Powered Tutoring Platform</h2>
                        <p class="text-muted small mb-2">
                            Adaptive tutoring system that personalizes learning content based on
                            student performance and engagement.
                        </p>

                        <div class="mb-2 small">
                            <span class="badge rounded-pill bg-primary-subtle text-primary me-1">AI</span>
                            <span class="badge rounded-pill bg-primary-subtle text-primary me-1">Education</span>
                            <span class="badge rounded-pill bg-primary-subtle text-primary me-1">MachineLearning</span>
                        </div>

                        <!-- avatars -->
                        <div class="d-flex align-items-center mb-3 small">
                            <div class="d-flex me-2">
                                <div class="rounded-circle bg-secondary bg-opacity-25 border border-white"
                                     style="width:24px;height:24px;margin-left:-6px;"></div>
                                <div class="rounded-circle bg-secondary bg-opacity-25 border border-white"
                                     style="width:24px;height:24px;margin-left:-6px;"></div>
                                <div class="rounded-circle bg-secondary bg-opacity-25 border border-white"
                                     style="width:24px;height:24px;margin-left:-6px;"></div>
                            </div>
                            <span class="text-muted small">3 participants</span>
                        </div>

                        <div class="mt-auto d-flex flex-wrap gap-2">
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm flex-fill js-track-cta"
                                    data-event="apply_to_join"
                                    data-project-id="ai-powered-tutoring">
                                Apply to Join
                            </button>
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm flex-fill js-track-cta"
                                    data-event="follow_project"
                                    data-project-id="ai-powered-tutoring">
                                Follow
                            </button>
                            <button type="button"
                                    class="btn btn-primary btn-sm flex-fill js-track-cta"
                                    data-event="request_mentorship"
                                    data-project-id="ai-powered-tutoring">
                                Offer Mentorship
                            </button>
                        </div>
                    </div>
                </article>
            </div>

            <!-- Card 2 -->
            <div class="col">
                <article class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden"
                         style="cursor:pointer;"
                         onclick="window.location='@Url.Page("/External/ProjectDetail", new { id = "sustainable-energy" })'">
                    <div style="height:190px;background:linear-gradient(135deg,#14532d,#22c55e);"
                         class="d-flex align-items-center justify-content-center">
                        <span class="text-white fw-semibold">Sustainable Energy Solutions</span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h2 class="h6 fw-semibold mb-2">Sustainable Energy Solutions</h2>
                        <p class="text-muted small mb-2">
                            Student-led initiative exploring renewable energy prototypes and
                            campus sustainability interventions.
                        </p>

                        <div class="mb-2 small">
                            <span class="badge rounded-pill bg-primary-subtle text-primary me-1">RenewableEnergy</span>
                            <span class="badge rounded-pill bg-primary-subtle text-primary me-1">Sustainability</span>
                        </div>

                        <div class="d-flex align-items-center mb-3 small">
                            <div class="d-flex me-2">
                                <div class="rounded-circle bg-secondary bg-opacity-25 border border-white"
                                     style="width:24px;height:24px;margin-left:-6px;"></div>
                                <div class="rounded-circle bg-secondary bg-opacity-25 border border-white"
                                     style="width:24px;height:24px;margin-left:-6px;"></div>
                            </div>
                            <span class="text-muted small">2 participants</span>
                        </div>

                        <div class="mt-auto d-flex flex-wrap gap-2">
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm flex-fill js-track-cta"
                                    data-event="apply_to_join"
                                    data-project-id="sustainable-energy">
                                Apply to Join
                            </button>
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm flex-fill js-track-cta"
                                    data-event="follow_project"
                                    data-project-id="sustainable-energy">
                                Follow
                            </button>
                            <button type="button"
                                    class="btn btn-primary btn-sm flex-fill js-track-cta"
                                    data-event="request_mentorship"
                                    data-project-id="sustainable-energy">
                                Offer Mentorship
                            </button>
                        </div>
                    </div>
                </article>
            </div>

            <!-- Card 3 -->
            <div class="col">
                <article class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden"
                         style="cursor:pointer;"
                         onclick="window.location='@Url.Page("/External/ProjectDetail", new { id = "mental-wellness-app" })'">
                    <div style="height:190px;background:linear-gradient(135deg,#047857,#dcfce7);"
                         class="d-flex align-items-center justify-content-center">
                        <span class="fw-semibold">Mobile App for Mental Wellness</span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h2 class="h6 fw-semibold mb-2">Mobile App for Mental Wellness</h2>
                        <p class="text-muted small mb-2">
                            Cross-platform mobile experience offering mood tracking, exercises, and
                            connections to campus resources.
                        </p>

                        <div class="mb-2 small">
                            <span class="badge rounded-pill bg-primary-subtle text-primary me-1">MentalHealth</span>
                            <span class="badge rounded-pill bg-primary-subtle text-primary me-1">MobileApp</span>
                        </div>

                        <div class="d-flex align-items-center mb-3 small">
                            <div class="d-flex me-2">
                                <div class="rounded-circle bg-secondary bg-opacity-25 border border-white"
                                     style="width:24px;height:24px;margin-left:-6px;"></div>
                            </div>
                            <span class="text-muted small">1 participant</span>
                        </div>

                        <div class="mt-auto d-flex flex-wrap gap-2">
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm flex-fill js-track-cta"
                                    data-event="apply_to_join"
                                    data-project-id="mental-wellness-app">
                                Apply to Join
                            </button>
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm flex-fill js-track-cta"
                                    data-event="follow_project"
                                    data-project-id="mental-wellness-app">
                                Follow
                            </button>
                            <button type="button"
                                    class="btn btn-primary btn-sm flex-fill js-track-cta"
                                    data-event="request_mentorship"
                                    data-project-id="mental-wellness-app">
                                Offer Mentorship
                            </button>
                        </div>
                    </div>
                </article>
            </div>

        </div>
    </section>
</div>

@section Scripts {
    <script>
        // Simple placeholder "analytics" events for CTAs
        document.querySelectorAll('.js-track-cta').forEach(btn => {
            btn.addEventListener('click', (event) => {
                // prevent the card click from firing when clicking buttons
                event.stopPropagation();
                const eventName = btn.dataset.event;
                const projectId = btn.dataset.projectId;
                console.log('analytics_event', {
                    event: eventName,
                    projectId: projectId,
                    source: 'public_projects_page'
                });
            });
        });
    </script>
}
