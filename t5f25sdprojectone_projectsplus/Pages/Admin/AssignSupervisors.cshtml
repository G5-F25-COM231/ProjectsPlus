@page
@{
    ViewData["Title"] = "Assign Project Supervisors";
    ViewData["ShowLoginLink"] = false; // hide Login link from main layout on admin pages
}

<div class="d-flex flex-column flex-lg-row gap-3">

    <!-- Sidebar -->
    <aside class="bg-white border rounded-4 p-3 p-lg-4" style="width: 260px; min-width: 220px;">
        <div class="mb-4">
            <div class="d-flex flex-column">
                <span class="fw-bold">Projects+</span>
                <span class="text-muted small">Administrator</span>
            </div>
        </div>

        <nav class="nav nav-pills flex-column gap-1 small">
            <a class="nav-link d-flex align-items-center" asp-page="/Admin/Users">
                <!-- Users icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" width="18" height="18" class="me-2">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87M16 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                Users
            </a>

            <a class="nav-link d-flex align-items-center disabled">
                <!-- Folder / projects icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" width="18" height="18" class="me-2">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M3 7h4l2 2h12v10H3V7z" />
                </svg>
                Projects
            </a>

            <a class="nav-link d-flex align-items-center active" asp-page="/Admin/AssignSupervisors">
                <!-- User plus icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" width="18" height="18" class="me-2">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 4a4 4 0 110 8 4 4 0 010-8zm8 8v4m2-2h-4m-6 2a6 6 0 016 6H6a6 6 0 016-6z" />
                </svg>
                Assign Supervisors
            </a>

            <a class="nav-link d-flex align-items-center disabled">
                <!-- Megaphone icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" width="18" height="18" class="me-2">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M11 5l6 2v6l-6 2V5zm-3.34.67A2 2 0 004 7.58v8.84a2 2 0 003.66 1.91L11 17V7l-3.34-1.33z" />
                </svg>
                Send Announcement
            </a>

            <a class="nav-link d-flex align-items-center disabled">
                <!-- Bell icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" width="18" height="18" class="me-2">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1" />
                </svg>
                Send Notification
            </a>
        </nav>
    </aside>

    <!-- Main content -->
    <section class="flex-grow-1">

        <!-- Top bar -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1 class="h4 fw-semibold mb-1">Assign Project Supervisors</h1>
                <p class="text-muted small mb-0">
                    Assign or update faculty supervisors for active projects.
                </p>
            </div>
            <div>
                <a asp-page="/Login" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    Logout
                </a>
            </div>
        </div>

        <!-- Search + filter -->
        <div class="bg-white border rounded-4 p-3 p-lg-4 mb-3 shadow-sm">
            <form class="row g-2 align-items-center">
                <div class="col-sm-9 col-md-10">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-transparent border-end-0">
                            🔍
                        </span>
                        <input type="search"
                               class="form-control border-start-0"
                               placeholder="Search projects by title..." />
                    </div>
                </div>
                <div class="col-sm-3 col-md-2 text-sm-end">
                    <button type="button" class="btn btn-outline-secondary btn-sm w-100">
                        Filter
                    </button>
                </div>
            </form>
        </div>

        <!-- Project cards -->
        <div class="d-flex flex-column gap-3">

            <!-- Project 1 -->
            <article class="bg-white border rounded-4 p-3 p-lg-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <h2 class="h6 fw-semibold mb-1">
                            AI-Powered Student Performance Analytics
                        </h2>
                        <p class="text-muted small mb-2">
                            Develop a predictive model to identify at-risk students based on their
                            academic performance and engagement data.
                        </p>
                        <p class="small mb-0">
                            <span class="text-muted">Current Supervisor:</span>
                            <span class="fw-semibold">Dr. Alan Grant</span>
                        </p>
                    </div>
                    <div class="text-end">
                        <button type="button"
                                class="btn btn-primary btn-sm rounded-pill px-3"
                                data-bs-toggle="modal"
                                data-bs-target="#assignSupervisorModal"
                                data-project-title="AI-Powered Student Performance Analytics"
                                data-current-supervisor="Dr. Alan Grant">
                            Change Supervisor
                        </button>
                    </div>
                </div>
            </article>

            <!-- Project 2 -->
            <article class="bg-white border rounded-4 p-3 p-lg-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <h2 class="h6 fw-semibold mb-1">
                            Sustainable Urban Farming Initiative
                        </h2>
                        <p class="text-muted small mb-2">
                            Design and implement a small-scale aquaponics system for urban food
                            production with a focus on sustainability and community engagement.
                        </p>
                        <p class="small mb-0">
                            <span class="text-muted">Current Supervisor:</span>
                            <span class="fw-semibold text-muted">Unassigned</span>
                        </p>
                    </div>
                    <div class="text-end">
                        <button type="button"
                                class="btn btn-success btn-sm rounded-pill px-3"
                                data-bs-toggle="modal"
                                data-bs-target="#assignSupervisorModal"
                                data-project-title="Sustainable Urban Farming Initiative"
                                data-current-supervisor="Unassigned">
                            Assign Supervisor
                        </button>
                    </div>
                </div>
            </article>

            <!-- Project 3 -->
            <article class="bg-white border rounded-4 p-3 p-lg-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <h2 class="h6 fw-semibold mb-1">
                            Campus Peer-to-Peer Tutoring Platform
                        </h2>
                        <p class="text-muted small mb-2">
                            Web application that connects students for academic tutoring, scheduling,
                            subject matching, and ratings.
                        </p>
                        <p class="small mb-0">
                            <span class="text-muted">Current Supervisor:</span>
                            <span class="fw-semibold">Dr. Sarah Harding</span>
                        </p>
                    </div>
                    <div class="text-end">
                        <button type="button"
                                class="btn btn-primary btn-sm rounded-pill px-3"
                                data-bs-toggle="modal"
                                data-bs-target="#assignSupervisorModal"
                                data-project-title="Campus Peer-to-Peer Tutoring Platform"
                                data-current-supervisor="Dr. Sarah Harding">
                            Change Supervisor
                        </button>
                    </div>
                </div>
            </article>

        </div>
    </section>
</div>

<!-- Assign / Change Supervisor Modal (UI only) -->
<div class="modal fade" id="assignSupervisorModal" tabindex="-1"
     aria-labelledby="assignSupervisorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="assignSupervisorModalLabel">Assign Supervisor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-2" id="currentProjectLabel">
                    Project:
                </p>

                <!-- Search supervisors -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Search supervisors</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-transparent border-end-0">🔍</span>
                        <input type="search" class="form-control border-start-0"
                               placeholder="Type a name, department, or expertise…" />
                    </div>
                </div>

                <!-- Example supervisor list (UI only) -->
                <div class="list-group small">
                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-semibold">Dr. Alice Lee</div>
                            <div class="text-muted">Computer Science · 2/4 projects</div>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            Available
                        </span>
                    </button>

                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-semibold">Dr. Robert Kim</div>
                            <div class="text-muted">Business · 3/3 projects</div>
                        </div>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                            Capacity reached
                        </span>
                    </button>

                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-semibold">Dr. Emily Chen</div>
                            <div class="text-muted">Design · 1/4 projects</div>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            Available
                        </span>
                    </button>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-primary btn-sm">
                    Save Assignment
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // When modal opens, update labels based on which button was clicked
        const assignModal = document.getElementById('assignSupervisorModal');
        if (assignModal) {
            assignModal.addEventListener('show.bs.modal', event => {
                const button = event.relatedTarget;
                if (!button) return;

                const title = button.getAttribute('data-project-title') || '';
                const current = button.getAttribute('data-current-supervisor') || '';

                const projectLabel = document.getElementById('currentProjectLabel');
                const titleLabel = document.getElementById('assignSupervisorModalLabel');

                if (titleLabel) {
                    titleLabel.textContent = (current && current !== 'Unassigned')
                        ? 'Change Supervisor'
                        : 'Assign Supervisor';
                }

                if (projectLabel) {
                    projectLabel.textContent = `Project: ${title} (Current: ${current})`;
                }
            });
        }
    </script>
}
