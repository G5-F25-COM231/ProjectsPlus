@page
@{
    ViewData["Title"] = "Project Review Queue";
}

<div class="container-fluid py-4">
    <div class="row">
        <!-- Sidebar -->
        <aside class="col-md-3 col-lg-2 mb-4">
            <div class="bg-white border rounded-3 p-3 h-100">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-2"
                         style="width:32px;height:32px;">
                        <span class="text-white fw-bold">P+</span>
                    </div>
                    <div>
                        <div class="fw-semibold small mb-0">Projects+</div>
                        <div class="text-muted small">Administrator</div>
                    </div>
                </div>

                <hr class="my-3" />

                <nav class="nav nav-pills flex-column gap-1 small">
                    <!-- Users -->
                    <a asp-page="/Admin/Users" class="nav-link d-flex align-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                             width="18" height="18" class="me-2">
                            <path fill="none" stroke="currentColor" stroke-width="1.7"
                                  stroke-linecap="round" stroke-linejoin="round"
                                  d="M16 14a4 4 0 0 1 4 4v1M4 19v-1a4 4 0 0 1 4-4m8-5a3 3 0 1 1-6 0a3 3 0 0 1 6 0Zm-8 0a3 3 0 1 1-6 0a3 3 0 0 1 6 0Z" />
                        </svg>
                        Users
                    </a>

                    <!-- Projects (disabled placeholder) -->
                    <a class="nav-link d-flex align-items-center disabled">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                             width="18" height="18" class="me-2">
                            <path fill="none" stroke="currentColor" stroke-width="1.7"
                                  stroke-linecap="round" stroke-linejoin="round"
                                  d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z" />
                        </svg>
                        Projects
                    </a>

                    <!-- Assign Supervisors -->
                    <a asp-page="/Admin/AssignSupervisors" class="nav-link d-flex align-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                             width="18" height="18" class="me-2">
                            <path fill="none" stroke="currentColor" stroke-width="1.7"
                                  stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 14.25c2.485 0 4.5-2.015 4.5-4.5S14.485 5.25 12 5.25S7.5 7.265 7.5 9.75s2.015 4.5 4.5 4.5Zm0 0c-3.114 0-6 1.007-6 3v.75h12v-.75c0-1.993-2.886-3-6-3Zm0-10.5l3.75 2.25M12 3.75L8.25 6" />
                        </svg>
                        Assign Supervisors
                    </a>

                    <!-- Current page: Review Queue -->
                    <a class="nav-link d-flex align-items-center active">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                             width="18" height="18" class="me-2">
                            <path fill="none" stroke="currentColor" stroke-width="1.7"
                                  stroke-linecap="round" stroke-linejoin="round"
                                  d="M9 5.25h6M9 3.75h6m-8.25 3h10.5A1.5 1.5 0 0 1 18.75 8.25v10.5A1.5 1.5 0 0 1 17.25 20.25H6.75A1.5 1.5 0 0 1 5.25 18.75V8.25A1.5 1.5 0 0 1 6.75 6.75ZM9 10.5l2 2.25l4-4.5" />
                        </svg>
                        Review Queue
                    </a>

                    <!-- Send Announcement -->
                    <a class="nav-link d-flex align-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                             width="18" height="18" class="me-2">
                            <path fill="none" stroke="currentColor" stroke-width="1.7"
                                  stroke-linecap="round" stroke-linejoin="round"
                                  d="M3.75 8.25v7.5m0-7.5L14.25 3.75v16.5L3.75 15.75m5.25.75v3m0-3c0-1.5-1.5-2.25-3-2.25" />
                        </svg>
                        Send Announcement
                    </a>

                    <!-- Send Notification with bell icon -->
                    <a class="nav-link d-flex align-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                             width="18" height="18" class="me-2">
                            <path fill="none" stroke="currentColor" stroke-width="1.7"
                                  stroke-linecap="round" stroke-linejoin="round"
                                  d="M14.25 18.75a2.25 2.25 0 1 1-4.5 0m9-2.25h-13.5l1.152-1.152a2.25 2.25 0 0 0 .66-1.591V9.75a5.25 5.25 0 0 1 10.5 0v3.007c0 .598.237 1.17.66 1.591L18.75 16.5Z" />
                        </svg>
                        Send Notification
                    </a>
                </nav>
            </div>
        </aside>

        <!-- Main content -->
        <main class="col-md-9 col-lg-10">
            <!-- Top bar -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h1 class="h4 fw-semibold mb-1">Project Review Queue</h1>
                    <p class="text-muted small mb-0">
                        Review new project submissions and approve or reject them.
                    </p>
                </div>
                <div>
                    <a asp-page="/Login" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        Logout
                    </a>
                </div>
            </div>

            <!-- Search & filters -->
            <section class="bg-white border rounded-3 p-3 mb-4">
                <div class="row g-2 align-items-center">
                    <div class="col-md">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0">
                                <!-- Magnifying glass icon -->
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                     width="16" height="16">
                                    <path fill="none" stroke="currentColor" stroke-width="1.7"
                                          stroke-linecap="round" stroke-linejoin="round"
                                          d="M10.5 6.75a3.75 3.75 0 1 1 0 7.5a3.75 3.75 0 0 1 0-7.5Zm6 9l-2.4-2.4" />
                                </svg>
                            </span>
                            <input type="search"
                                   class="form-control border-start-0"
                                   placeholder="Search submissions by project title or owner..." />
                        </div>
                    </div>
                    <div class="col-auto">
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            Filter
                        </button>
                    </div>
                </div>
            </section>

            <!-- Review queue list -->
            <section class="bg-white border rounded-3 p-0">
                <div class="border-bottom p-3 pb-2">
                    <h2 class="h6 mb-1">Pending Submissions</h2>
                    <p class="text-muted small mb-0">
                        Approve or reject new project submissions. A notification will be sent to
                        the project owner after each decision.
                    </p>
                </div>

                <!-- Example row 1 -->
                <article class="border-bottom p-3">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                            <h3 class="h6 mb-1">AI-Powered Student Performance Analytics</h3>
                            <p class="text-muted small mb-1">
                                Submitted by <strong>John Doe</strong> · Submitted on 2025-10-27
                            </p>
                            <p class="text-muted small mb-0">
                                Predictive model to identify at-risk students based on academic data.
                            </p>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                    data-bs-toggle="modal"
                                    data-bs-target="#rejectModal">
                                Reject
                            </button>
                            <button type="button"
                                    class="btn btn-success btn-sm rounded-pill px-3"
                                    data-bs-toggle="modal"
                                    data-bs-target="#approveModal">
                                Approve
                            </button>
                        </div>
                    </div>
                </article>

                <!-- Example row 2 -->
                <article class="border-bottom p-3">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                            <h3 class="h6 mb-1">Sustainable Urban Farming Initiative</h3>
                            <p class="text-muted small mb-1">
                                Submitted by <strong>Emily Carter</strong> · Submitted on 2025-10-25
                            </p>
                            <p class="text-muted small mb-0">
                                Small-scale aquaponics system for urban food production.
                            </p>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                    data-bs-toggle="modal"
                                    data-bs-target="#rejectModal">
                                Reject
                            </button>
                            <button type="button"
                                    class="btn btn-success btn-sm rounded-pill px-3"
                                    data-bs-toggle="modal"
                                    data-bs-target="#approveModal">
                                Approve
                            </button>
                        </div>
                    </div>
                </article>

                <!-- Empty state (for future dynamic use) -->
                <div class="p-4 text-center text-muted small">
                    No more pending submissions. New project requests will appear here.
                </div>
            </section>
        </main>
    </div>
</div>

<!-- Approve confirmation modal -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title h6" id="approveModalLabel">Approve project submission</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body small">
                Are you sure you want to <strong>approve</strong> this project?
                <br />
                A notification will be sent to the project owner.
            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary btn-sm rounded-pill px-3"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button"
                        class="btn btn-success btn-sm rounded-pill px-3">
                    Confirm Approve
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reject confirmation modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title h6" id="rejectModalLabel">Reject project submission</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body small">
                <p class="mb-2">
                    Are you sure you want to <strong>reject</strong> this project?
                </p>
                <label class="form-label small mb-1" for="rejectReason">
                    Rejection reason (optional)
                </label>
                <textarea id="rejectReason"
                          class="form-control form-control-sm"
                          rows="3"
                          placeholder="Provide a brief explanation that will be shared with the project owner."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary btn-sm rounded-pill px-3"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button"
                        class="btn btn-danger btn-sm rounded-pill px-3">
                    Confirm Reject
                </button>
            </div>
        </div>
    </div>
</div>
